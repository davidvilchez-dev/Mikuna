# Copia este archivo como .env y completa los valores locales.
DB_URL=jdbc:postgresql://localhost:5432/mikuna_db
DB_USERNAME=postgres
DB_PASSWORD=cambia-esto
SERVER_PORT=8080
# Mínimo 32 caracteres aleatorios (p. ej.: openssl rand -base64 48)
MIKUNA_JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
MIKUNA_JWT_EXPIRATION=PT2H
# Cloudinary (imagenes de productos); valores de tu cuenta, nunca en commits
cloudinary.cloud-name=
cloudinary.api-key=
cloudinary.api-secret=
# Carrito y direcciones (reglas de negocio; sin valores por defecto, define los tuyos)
# Distritos cubiertos separados por comas, p. ej.: Distrito A,Distrito B
MIKUNA_DELIVERY_DISTRICTS=
# Tarifa fija de envio en soles con punto decimal, p. ej.: 0.00
MIKUNA_DELIVERY_FEE=
# Comision como porcentaje del subtotal (0 a 100), p. ej.: 0
MIKUNA_COMMISSION_RATE=
# Stripe (pasarela de pagos, SOLO modo de pruebas/sandbox); claves de tu cuenta, nunca en commits
# Clave secreta del backend: debe empezar con sk_test_
STRIPE_SECRET_KEY=
# Clave publicable para el formulario de pago del frontend: debe empezar con pk_test_
STRIPE_PUBLISHABLE_KEY=
# Moneda de los pagos (opcional; por defecto pen). Confirma que tu cuenta de pruebas de Stripe la admite.
# MIKUNA_PAYMENTS_CURRENCY=pen

# Vencimiento de pedidos pendientes (spec 012). Plazo para que el restaurante responda (por defecto 15 min)
# e intervalo del barrido que cancela los vencidos (por defecto 15 s).
# MIKUNA_ORDER_RESPONSE_TIMEOUT=PT15M
# MIKUNA_ORDER_EXPIRY_SWEEP=PT15S

# Asistente de IA (spec 013). Clave gratuita de Google AI Studio; nunca en commits.
# Vacia = el chat avisa que no esta disponible y el resto de Mikuna funciona igual.
GEMINI_API_KEY=
# Modelo de Gemini (opcional; por defecto gemini-flash-latest). Confirma en la documentacion el nombre vigente.
# GEMINI_MODEL=gemini-flash-latest
# Mensajes por minuto y por cliente (por defecto 10) y longitud maxima de cada mensaje (por defecto 500).
# MIKUNA_ASSISTANT_RATE_LIMIT=10
# MIKUNA_ASSISTANT_MAX_LENGTH=500
