# Copia este archivo como .env y completa los valores locales.
DB_URL=jdbc:postgresql://localhost:5432/mikuna_db
DB_USERNAME=postgres
DB_PASSWORD=cambia-esto
SERVER_PORT=8080
# Mínimo 32 caracteres aleatorios (p. ej.: openssl rand -base64 48)
MIKUNA_JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
MIKUNA_JWT_EXPIRATION=PT2H
# Cloudinary (imagenes de productos); valores de tu cuenta, nunca en commits
cloudinary.cloud-name=
cloudinary.api-key=
cloudinary.api-secret=
# Carrito y direcciones (reglas de negocio; sin valores por defecto, define los tuyos)
# Distritos cubiertos separados por comas, p. ej.: Distrito A,Distrito B
MIKUNA_DELIVERY_DISTRICTS=
# Tarifa fija de envio en soles con punto decimal, p. ej.: 0.00
MIKUNA_DELIVERY_FEE=
# Comision como porcentaje del subtotal (0 a 100), p. ej.: 0
MIKUNA_COMMISSION_RATE=
